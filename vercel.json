{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://commodities-expired-alfred-photographers.trycloudflare.com/api/:path*"
    },
    {
      "source": "/meetings/:path*",
      "destination": "https://commodities-expired-alfred-photographers.trycloudflare.com/meetings/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://commodities-expired-alfred-photographers.trycloudflare.com/ws/:path*"
    }
  ],
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist"
}
